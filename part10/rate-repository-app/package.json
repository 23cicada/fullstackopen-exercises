{
  "name": "rate-repository-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "android:proxy": "set HTTP_PROXY=https://127.0.0.1:7890 && set HTTPS_PROXY=https://127.0.0.1:7890 && npm run android",
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "codegen": "graphql-codegen --config codegen.ts",
    "tsc": "tsc",
    "prebuild": "npx expo prebuild --clean",
    "prettier": "prettier . --write",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@apollo/client": "^4.1.9",
    "@expo/metro-runtime": "~55.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/elements": "^2.9.18",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "^55.0.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~55.0.24",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.33",
    "expo-linking": "~55.0.15",
    "expo-status-bar": "~55.0.6",
    "formik": "^2.4.9",
    "graphql": "^16.14.0",
    "nativewind": "^4.2.3",
    "patch-package": "^8.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "yup": "^1.7.1"
  },
  "private": true,
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript-operations": "^6.0.2",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-test-renderer": "19.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-router-native)"
    ]
  }
}
